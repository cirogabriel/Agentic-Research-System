# URL base de la API del backend FastAPI (incluye el prefijo /api/v1).
#  - Desarrollo directo:      http://localhost:8000/api/v1   (requiere CORS_ORIGINS en el backend)
#  - Detrás de nginx/proxy:   /api/v1                        (sin CORS; es el valor por defecto de la imagen Docker)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Timeout (ms) de las peticiones HTTP normales. El stream SSE no usa este límite.
VITE_API_TIMEOUT_MS=30000

# Solo `npm run dev`: si se define, Vite redirige /api al backend (permite usar VITE_API_BASE_URL=/api/v1 sin CORS).
# DEV_PROXY_TARGET=http://localhost:8000

# NOTA: no hay claves de OpenAI aquí ni en ningún archivo del frontend. Viven solo en el backend.
# Si el backend define API_KEY, introdúcela en Configuración → Conexión (se guarda en sessionStorage, nunca en el bundle).
