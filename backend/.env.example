# ==== Aplicación ====
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true
# Si se define, todas las rutas (salvo /health) exigen la cabecera X-API-Key.
API_KEY=

# ==== Base de datos ====
# En Docker Compose el host es "db"; en local es "localhost".
DATABASE_URL=postgresql+psycopg://ars:ars@localhost:5432/ars
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=500

# ==== OpenAI ====
OPENAI_API_KEY=
# Opcional: endpoint compatible con OpenAI.
OPENAI_BASE_URL=
# Un único modelo generativo para TODOS los agentes.
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Precios en USD por millón de tokens (solo para estimar costos; actualízalos según tu modelo).
LLM_PRICE_INPUT_PER_MTOK=0.15
LLM_PRICE_OUTPUT_PER_MTOK=0.60
# Modelo de embeddings (distinto del generativo). La dimensión debe coincidir con la migración.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
EMBEDDING_PRICE_PER_MTOK=0.02

# ==== Chunking ====
CHUNK_STRATEGY=recursive
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ==== Recuperación ====
# auto | vector | keyword | hybrid
RETRIEVAL_STRATEGY=auto
# auto | none | rewrite | multi_query | rag_fusion | hyde
QUERY_TRANSFORM=auto
RETRIEVAL_TOP_K=5
RRF_K=60
HYDE_ENABLED=false
ROUTER_LLM_FALLBACK=false
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATE_MULTIPLIER=4
RERANK_DEVICE=cpu
RETRIEVAL_CACHE_TTL_SECONDS=300

# ==== Agentes y control de costos ====
MAX_ITERATIONS=3
MAX_SUBTASKS=4
MAX_FOLLOWUP_TASKS=2
TOKEN_BUDGET=60000
REPORT_RESERVE_RATIO=0.2
QUERY_PROCESSOR_MODE=auto
VERIFICATION_MODE=hybrid
# direct = servicios Python en proceso; mcp = el Research Agent usa el servidor MCP de recuperación (stdio)
AGENT_TOOL_TRANSPORT=direct
BACKGROUND_WORKERS=4
CHECKPOINTING_ENABLED=true

# ==== MCP (solo cuando se ejecutan como servicios HTTP) ====
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8001

# ==== Ajustes avanzados (valores por defecto entre paréntesis) ====
DB_POOL_SIZE=10                    # conexiones del pool SQLAlchemy
MAX_UNCOMPRESSED_MB=200            # límite al descomprimir DOCX (anti zip-bomb)
CORS_ORIGINS=[]                    # lista JSON, p. ej. ["http://localhost:5173"]
EMBEDDING_BATCH_SIZE=64
CHUNK_SEPARATORS=["\n\n", "\n", ". ", " ", ""]
RERANK_BATCH_SIZE=16
RETRIEVAL_CACHE_SIZE=256
MULTI_QUERY_COUNT=3
MAX_FOLLOWUP_TASKS=2
EVIDENCE_PER_TASK=5                # fragmentos por subtarea enviados al análisis
ANALYSIS_MAX_EVIDENCE_CHARS=12000  # tope de caracteres de evidencia por análisis
MAX_FINDINGS=12
MIN_EVIDENCE_COVERAGE=0.7          # cobertura mínima para considerar suficiente la evidencia
MAX_UNSUPPORTED_RATIO=0.25
VERIFICATION_SUPPORT_THRESHOLD=0.6 # solapamiento léxico a partir del cual un hecho se da por respaldado
VERIFICATION_MAX_LLM_FINDINGS=8
MESSAGE_CONTEXT_TOKENS=1500        # tope de contexto de mensajes entre agentes (trim_messages)
MESSAGE_KEEP_LAST=6                # mensajes que se conservan al podar el historial
MAX_PARALLEL_WORKERS=4             # workers de investigación simultáneos por iteración
GRAPH_RECURSION_LIMIT=60
